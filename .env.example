# Ferrite Provider Configuration (ADR 0011)
# Default mode is "replay" (offline-first, deterministic reference Rust fixtures).
# Set FERRITE_PROVIDER=openai to use a live OpenAI-compatible endpoint.
FERRITE_PROVIDER=replay
FERRITE_REPLAY_DIR=fixtures/replay

# OpenAI-compatible HTTP provider settings (used when FERRITE_PROVIDER=openai or --provider openai):
FERRITE_API_BASE=https://api.studio.nebius.ai/v1
FERRITE_API_KEY=replace-me
FERRITE_MODEL=nvidia/Llama-3.3-Nemotron-Super-49B-v1

# Legacy Nebius Token Factory aliases:
NEBIUS_TOKEN_FACTORY_URL=https://api.studio.nebius.ai/v1
NEBIUS_API_KEY=replace-me
